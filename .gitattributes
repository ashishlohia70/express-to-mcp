# Normalize to LF in the repository and on checkout everywhere. Without this,
# Windows clones rewrite every file to CRLF and contributors on other platforms
# see whole-file diffs.
* text=auto eol=lf

# Collapse the lockfile in GitHub's diff view, but keep it a normal diffable
# text file locally (`-diff` would make git report it as binary).
package-lock.json linguist-generated=true

*.png binary
*.jpg binary
*.ico binary
*.tgz binary
