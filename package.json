{
  "name": "express-to-mcp",
  "version": "0.1.0",
  "description": "Bridge an existing Express router into MCP tools, dispatched in-memory with no network hop.",
  "license": "MIT",
  "author": "Ashish Lohia (https://github.com/ashishlohia70)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashishlohia70/express-to-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ashishlohia70/express-to-mcp/issues"
  },
  "homepage": "https://github.com/ashishlohia70/express-to-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "express",
    "mcp",
    "model-context-protocol",
    "llm",
    "tools",
    "ai",
    "agent",
    "claude",
    "openapi",
    "rest"
  ],
  "dependencies": {
    "path-to-regexp": "^8.4.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25 || ^4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "overrides": {
  "esbuild": "^0.28.1"
}
}
